{
  "defaults": {
    "output_root": "DO NOT COMMIT/tsp_suite/smoke",
    "agent": {
      "name": "learner",
      "provider": "builtin",
      "model": "tsp_default",
      "regenerate_each_epoch": true
    },
    "generation": {
      "repair_invalid_submissions": false
    },
    "selection": {
      "mode": "score_only",
      "elite_archive_enabled": true
    },
    "benchmark": {
      "manifest_path": "benchmarks/tsp/smoke_manifest.json",
      "curriculum_batch_size": 3,
      "transfer_probe_count": 2,
      "adversarial_probe_count": 2
    },
    "optimization": {
      "epochs": 3
    },
    "judge": {
      "enabled": false
    },
    "metadata": {
      "phase": "phase_5_smoke"
    }
  },
  "conditions": [
    {
      "name": "smoke_no_replay",
      "seed": 101,
      "replay": {
        "mode": "none",
        "replay_instance_count": 0
      }
    },
    {
      "name": "smoke_failure_replay",
      "seed": 202,
      "agent": {
        "name": "learner",
        "provider": "builtin",
        "model": "clustered_search",
        "regenerate_each_epoch": true
      },
      "replay": {
        "mode": "failure",
        "archive_max_size": 8,
        "replay_instance_count": 2,
        "catastrophic_gap_threshold": 0.02
      },
      "selection": {
        "mode": "novelty_gate",
        "novelty_threshold": 0.04,
        "score_tolerance": 0.004,
        "replay_gap_tolerance": 0.006,
        "transfer_gap_tolerance": 0.008,
        "elite_archive_enabled": true,
        "compression_pressure": true,
        "max_complexity_increase": 0.5
      }
    }
  ]
}
