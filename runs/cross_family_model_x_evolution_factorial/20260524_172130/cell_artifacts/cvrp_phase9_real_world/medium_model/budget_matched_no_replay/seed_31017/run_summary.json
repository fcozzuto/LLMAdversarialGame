      "execution_mode": "direct_factorial_candidate",
      "final_code": "def solve_cvrp(instance):\n    depot = instance[\"depot_index\"]\n    customers = set(instance[\"customer_ids\"])\n    demands = instance[\"demands\"]\n    capacity = instance[\"capacity\"]\n    matrix = instance[\"distance_matrix\"]\n    routes = []\n    while customers:\n        route = []\n        load = 0\n        current = depot\n        while True:\n            feasible = [node for node in customers if load + demands[node] <= capacity]\n            if not feasible:\n                break\n            nxt = min(feasible, key=lambda node: (matrix[current][node], demands[node], node))\n            route.append(nxt)\n            customers.remove(nxt)\n            load += demands[nxt]\n            current = nxt\n        routes.append(route)\n    return routes\n",
